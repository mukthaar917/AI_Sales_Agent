# Application
APP_NAME=AI Sales Agent
APP_ENV=development
DEBUG=true

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=ai_sales_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Local backend connection
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ai_sales_agent

# Backend connection when running inside Docker
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:change-me@postgres:5432/ai_sales_agent

# Redis
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gmail integration — required in Phase 2
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# OAuth token encryption — required in Phase 2
OAUTH_TOKEN_ENCRYPTION_KEY=

# AI provider — required in later phases
AI_API_KEY=